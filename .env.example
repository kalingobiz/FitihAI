# Required
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot (only needed for `python -m fitihai.telegram_bot`)
TELEGRAM_BOT_TOKEN=

# Models (defaults shown)
FITIH_REASONING_MODEL=claude-sonnet-5
FITIH_FAST_MODEL=claude-haiku-4-5
FITIH_OCR_MODEL=claude-sonnet-5
# claude | gemini   (gemini needs `pip install google-genai` and GEMINI_API_KEY)
FITIH_OCR_PROVIDER=claude
FITIH_GEMINI_OCR_MODEL=gemini-2.5-flash

# Storage
FITIH_DB=data/fitihai.db
FITIH_CORPUS_DIR=corpus/laws

# Behaviour
FITIH_TOP_K=8
FITIH_SESSION_TTL_MINUTES=30
FITIH_MAX_HISTORY_TURNS=6
FITIH_MAX_UPLOAD_MB=10
# Document analyses per Telegram user per month; 0 = unlimited
FITIH_FREE_ANALYSES_PER_MONTH=0
# Random secret used to hash user IDs in usage counters
FITIH_USAGE_SALT=change-me
