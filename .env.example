# ---- AI provider -------------------------------------------------------------
# gemini (default; generous free tier) or claude
FITIH_LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Only needed when FITIH_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# IMPORTANT: on the Gemini API *free* tier Google may use prompts/responses to
# improve its products. Use it for development and pilots with test documents.
# Enable billing (paid tier) before real users send personal documents.

# Gemini models (check current names/limits in Google AI Studio)
FITIH_GEMINI_REASONING_MODEL=gemini-2.5-flash
FITIH_GEMINI_FAST_MODEL=gemini-2.5-flash-lite
FITIH_GEMINI_OCR_MODEL=gemini-2.5-flash

# Claude models
FITIH_CLAUDE_REASONING_MODEL=claude-sonnet-5
FITIH_CLAUDE_FAST_MODEL=claude-haiku-4-5
FITIH_CLAUDE_OCR_MODEL=claude-sonnet-5

# ---- RAG ---------------------------------------------------------------------
# gemini = hybrid keyword + semantic search (needs GEMINI_API_KEY even when the
# LLM provider is claude); none = keyword search only
FITIH_EMBEDDINGS=gemini
FITIH_EMBEDDING_MODEL=gemini-embedding-001
FITIH_EMBEDDING_DIM=768
FITIH_TOP_K=8

# ---- Law downloader (fitihai.cli fetch / admin "link" import) -------------------
# Seconds between requests to the same website, and a contact (email or URL) sent in
# the User-Agent so site owners can reach you.
FITIH_FETCH_DELAY=2
FITIH_FETCH_CONTACT=

# ---- Admin console (/admin) ---------------------------------------------------
# Long random secret; empty disables the admin console. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FITIH_ADMIN_TOKEN=

# ---- Protection ----------------------------------------------------------------
# Requests per minute per client for /api/ask and /api/analyze (0 = no limit)
FITIH_RATE_LIMIT_PER_MINUTE=20
# Set to 1 behind a reverse proxy (Railway, Render, nginx) so clients are told apart
FITIH_TRUST_PROXY=0

# ---- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---- Storage & behaviour -----------------------------------------------------
FITIH_DB=data/fitihai.db
FITIH_CORPUS_DIR=corpus/laws
FITIH_SESSION_TTL_MINUTES=30
FITIH_MAX_HISTORY_TURNS=6
FITIH_MAX_UPLOAD_MB=10
# Document analyses per Telegram user per month; 0 = unlimited
FITIH_FREE_ANALYSES_PER_MONTH=0
# Random secret used to hash user IDs in usage counters (set a long random value)
FITIH_USAGE_SALT=change-me
